# OpenCode Manager configuration
# Copy to /etc/opencode-manager/config.env only if you need to override defaults.

SOURCE_USER=abdotaher
MANAGED_PREFIX=opencode
SHARED_GROUP=opencode-shared

# Runtime paths
STATE_DIR=/opt/opencode-manager/state
LOG_DIR=/opt/opencode-manager/logs
CACHE_DIR=/opt/opencode-manager/bin
SHARED_DIR=/opt/opencode-manager/shared
LOCK_FILE=/run/lock/opencode-manager.lock
INSTALL_PATH=/usr/local/bin/opencode-manager

# Source OpenCode installation used to seed the local cache.
SOURCE_BIN=/home/abdotaher/.opencode/bin/opencode

# Manager behavior
AUTO_ROTATE=1
MAX_ROTATIONS_PER_RUN=20
TEMP_RATE_LIMIT_SLEEP=30
NETWORK_RETRY_SLEEP=10
MAX_NETWORK_RETRIES=5
